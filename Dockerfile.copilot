# Clinical Co-Pilot agent service, built from the repository root: Railway uploads the
# whole repo with `railway up`, so the build context is the root and this file lives
# here, with root-relative COPY paths. It is the only Dockerfile for this service.
# The service is private-network only; the OpenEMR module is its client.
FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8600
WORKDIR /app

COPY copilot/requirements.txt ./
# CPU-only torch first, so sentence-transformers does not pull the CUDA build into the image.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir -r requirements.txt

COPY copilot/copilot ./copilot
COPY copilot/evals ./evals
# The two retrieval models are fetched at build time, so a cold start never downloads.
ENV HF_HOME=/app/.hf
RUN python -c "from sentence_transformers import SentenceTransformer, CrossEncoder; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2'); CrossEncoder('cross-encoder/ms-marco-MiniLM-L-6-v2')"

RUN useradd --create-home --uid 10001 copilot && chown -R copilot:copilot /app/.hf
USER copilot

EXPOSE 8600
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD python -c "import urllib.request,os,sys; sys.exit(0 if urllib.request.urlopen(f'http://127.0.0.1:{os.environ.get(\"PORT\",\"8600\")}/healthz').status==200 else 1)"

CMD ["sh", "-c", "uvicorn copilot.service.app:app --host 0.0.0.0 --port ${PORT}"]
