# Copy to .env on the droplet and fill in. Never commit .env.
# Generate each password with: openssl rand -base64 24 | tr -d '/+=' | cut -c1-24

# <droplet-ip-with-dashes>.sslip.io resolves to the droplet, so Let's Encrypt can issue a certificate for it.
DOMAIN=203-0-113-10.sslip.io
# Optional: Let's Encrypt emails expiry warnings here.
LE_EMAIL=

MYSQL_ROOT_PASS=change-me
MYSQL_PASS=change-me
OE_PASS=change-me
