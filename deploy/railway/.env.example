# Values to set as Railway service variables (NOT committed; Railway stores them).
# Generate each password locally, e.g. in PowerShell:
#   -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 28 | % {[char]$_})

# The generated Railway domain for the openemr service, without https://
PUBLIC_DOMAIN=openemr-production-xxxx.up.railway.app

# MariaDB root password. With Railway's MariaDB template, reference the template's
# variable instead of a literal: ${{MariaDB.MARIADB_ROOT_PASSWORD}}
MYSQL_ROOT_PASS=change-me

# Password the image creates for the openemr database user
MYSQL_PASS=change-me

# Password for the admin login (replaces the default "pass")
OE_PASS=change-me
