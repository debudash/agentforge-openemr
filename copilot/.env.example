# Copy to .env (gitignored). Never commit real values.

# Shared with the OpenEMR module (sites/<site>/copilot-config.php or COPILOT_SHARED_SECRET on the service).
COPILOT_SHARED_SECRET=change-me-64-hex-chars

# Model gateway (PRD PHI1): only the allowlisted provider/model/endpoint may receive data.
# Option A: Anthropic directly
#COPILOT_PROVIDER=anthropic
#COPILOT_MODEL=claude-sonnet-5
#COPILOT_ALLOWED_PROVIDERS=anthropic
#COPILOT_ALLOWED_MODELS=claude-sonnet-5
#COPILOT_ALLOWED_ENDPOINTS=https://api.anthropic.com
#ANTHROPIC_API_KEY=
# Option B: OpenRouter (OpenAI-compatible; model slugs carry the vendor prefix)
COPILOT_PROVIDER=openrouter
COPILOT_MODEL=anthropic/claude-sonnet-5
COPILOT_ALLOWED_PROVIDERS=openrouter
COPILOT_ALLOWED_MODELS=anthropic/claude-sonnet-5
COPILOT_ALLOWED_ENDPOINTS=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=

# Observability (PRD PHI7). Set COPILOT_TRACE_REDACT=true to hide prompts and outputs in LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openemr-copilot
COPILOT_TRACE_REDACT=false

# Agent behaviour
COPILOT_MAX_ITERATIONS=5
COPILOT_COMPARISON_HOURS=24
COPILOT_RECENT_LAB_DAYS=180
COPILOT_PREFETCH_CONCURRENCY=6
COPILOT_PREFETCH_BUDGET_S=90
COPILOT_ANSWER_DEADLINE_S=60
COPILOT_SESSION_IDLE_MINUTES=120
