# Copy to .env (gitignored). Never commit real values.

# Shared with the OpenEMR module (sites/<site>/copilot-config.php or COPILOT_SHARED_SECRET on the service).
COPILOT_SHARED_SECRET=change-me-64-hex-chars

# Model gateway (PRD PHI1): only the allowlisted provider/model/endpoint may receive data.
# Option A: Anthropic directly
#COPILOT_PROVIDER=anthropic
#COPILOT_MODEL=claude-sonnet-5
#COPILOT_ALLOWED_PROVIDERS=anthropic
#COPILOT_ALLOWED_MODELS=claude-sonnet-5
#COPILOT_ALLOWED_ENDPOINTS=https://api.anthropic.com
#ANTHROPIC_API_KEY=
# Option B: OpenRouter (OpenAI-compatible; model slugs carry the vendor prefix). Free-tier
# slugs end in ":free"; they need tool calling and structured output (check supported_parameters)
# and are rate-limited, so lower COPILOT_PREFETCH_CONCURRENCY with them.
COPILOT_PROVIDER=openrouter
COPILOT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
COPILOT_JUDGE_MODEL=google/gemma-4-31b-it:free      # eval judge; empty = same as the agent
COPILOT_ALLOWED_PROVIDERS=openrouter
COPILOT_ALLOWED_MODELS=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,anthropic/claude-sonnet-5
COPILOT_ALLOWED_ENDPOINTS=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
COPILOT_REASONING=off      # off | default | low | medium | high; reasoning models otherwise spend max_tokens on hidden thinking

# Observability (PRD PHI7). Set COPILOT_TRACE_REDACT=true to hide prompts and outputs in LangSmith.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=openemr-copilot
COPILOT_TRACE_REDACT=false

# Agent behaviour
COPILOT_MAX_ITERATIONS=5
COPILOT_COMPARISON_HOURS=24
COPILOT_RECENT_LAB_DAYS=180
COPILOT_PREFETCH_CONCURRENCY=6
COPILOT_PREFETCH_BUDGET_S=90
COPILOT_ANSWER_DEADLINE_S=60
COPILOT_SESSION_IDLE_MINUTES=120

# Where OpenEMR is, for the /ready probe only. The agent never calls OpenEMR in normal
# operation -- data flows inward -- so it cannot infer the address, and /ready reports the
# dependency as unchecked when this is unset.
#   local host process : https://localhost:9300/interface/login/login.php
#   Railway            : https://<app>.up.railway.app/interface/login/login.php
COPILOT_OPENEMR_URL=
