/.idea/*
/.vscode/*
/.vscode-oss/*
/nbproject/*
.DS_Store
.buildpath
.project
.settings

# testing
.phpunit.result.cache

# generated data exports (rebuildable from the database; see scripts/)
/exports/

# dev tool local overrides
phpcs.xml
phpstan.neon
coverage/js-unit

# phpstan
tmp-phpstan/*

# easy dev worktree support
.worktrees.json
.worktrees.json.lock
docker/development-easy/docker-compose.override.yml
docker/development-easy-light/docker-compose.override.yml
docker/development-easy-redis/docker-compose.override.yml
compose.override.yml
tmp/
.webpack-cache/

