{
  "info": {
    "name": "OpenEMR API",
    "_postman_id": "6f1c2a8e-3b7d-4c55-9e0a-0e7a5d1b2c01",
    "description": "OpenEMR REST + FHIR R4 for the local dev stack and the Railway deployment. Pick the **LocalOpenEMR** or **RailwayOpenEMR** environment; requests are identical.\n\nFirst run per environment: Auth/1 Register client, enable the client in Admin > System > API Clients, then Auth/2 Get token. Run 'Patients (list)' or 'Patient search' before the per-patient requests; they save patientUuid/patientPid.\n\nLocal uses a self-signed certificate: turn off Settings > General > SSL certificate verification.\n\nRead-only by design. Railway is production: do not add write requests without approval.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Register client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/oauth2/{{site}}/registration",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "{{site}}",
                "registration"
              ]
            },
            "description": "Registers a private OAuth client and saves clientId/clientSecret to the active environment.\n\n**New clients start disabled.** Enable it in OpenEMR: Admin > System > API Clients > edit > Enable. Run once per environment; skip if clientId is already set.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"application_type\": \"private\",\n  \"redirect_uris\": [\n    \"https://client.example.org/callback\"\n  ],\n  \"client_name\": \"postman-{{envName}}\",\n  \"token_endpoint_auth_method\": \"client_secret_post\",\n  \"contacts\": [\n    \"admin@example.org\"\n  ],\n  \"scope\": \"{{scope}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"client registered\", () => pm.expect(pm.response.code).to.be.below(400));",
                  "const j = pm.response.json();",
                  "pm.environment.set(\"clientId\", j.client_id);",
                  "pm.environment.set(\"clientSecret\", j.client_secret || \"\");",
                  "console.log(\"Enable this client in Admin > System > API Clients:\", j.client_id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get token (password grant)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth2/{{site}}/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "{{site}}",
                "token"
              ]
            },
            "description": "Password grant as an OpenEMR user. Requires Admin > Config > Connectors > 'Enable OAuth2 Password Grant' to allow users. Saves accessToken and refreshToken; every other request uses {{accessToken}}.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}",
                  "type": "text"
                },
                {
                  "key": "user_role",
                  "value": "users",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "{{username}}",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "{{password}}",
                  "type": "text"
                },
                {
                  "key": "scope",
                  "value": "{{scope}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"token issued\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set(\"accessToken\", j.access_token);",
                  "if (j.refresh_token) pm.environment.set(\"refreshToken\", j.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Refresh token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth2/{{site}}/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "oauth2",
                "{{site}}",
                "token"
              ]
            },
            "description": "Exchanges refreshToken for a new access token (needs offline_access in scope).",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "refresh_token",
                  "type": "text"
                },
                {
                  "key": "client_id",
                  "value": "{{clientId}}",
                  "type": "text"
                },
                {
                  "key": "client_secret",
                  "value": "{{clientSecret}}",
                  "type": "text"
                },
                {
                  "key": "refresh_token",
                  "value": "{{refreshToken}}",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"token refreshed\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.environment.set(\"accessToken\", j.access_token);",
                  "if (j.refresh_token) pm.environment.set(\"refreshToken\", j.refresh_token);"
                ]
              }
            }
          ]
        }
      ]
    },
